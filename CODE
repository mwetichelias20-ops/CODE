/* FEE CALCULATOR */

function calculateFees(){

const amount =
Number(
document.getElementById("loanAmount").value
) || 0;

const processing =
amount * .025;

const collateral =
document.getElementById("noCollateral").checked
? amount * .03
: 0;

document.getElementById("processingFee").textContent =
formatCurrency(processing);

document.getElementById("collateralFee").textContent =
formatCurrency(collateral);

document.getElementById("totalFees").textContent =
formatCurrency(processing + collateral);

document
.getElementById("collateralFeeRow")
.classList.toggle(
"hidden",
collateral===0
);

}



function formatCurrency(num){

return new Intl.NumberFormat(
"en-US",
{
style:"currency",
currency:"USD"
}
).format(num);

}



